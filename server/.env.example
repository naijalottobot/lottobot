# Copy to .env and fill in. Never commit the real .env file.
# MODE=test  -> local development (relaxed checks, warns instead of failing).
# MODE=live  -> production (server refuses to start unless all values are set).

MODE=test
PORT=3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
BOT_TOKEN=
ADMIN_KEY=change-me-to-a-long-random-string
DRAW_SECRET=change-me-to-a-long-random-string
# Optional shared key for Monetag server-side postbacks. If set, Monetag must
# include it: https://YOUR-API.onrender.com/api/monetag/postback?key=YOUR_KEY
MONETAG_POSTBACK_KEY=
RENDER_GIT_COMMIT=local
