# Copy to .env and fill in. Never commit the real .env file.
# MODE=test  -> local development (relaxed checks, warns instead of failing).
# MODE=live  -> production (server refuses to start unless all values are set).

MODE=test
PORT=3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
BOT_TOKEN=
ADMIN_KEY=change-me-to-a-long-random-string
DRAW_SECRET=change-me-to-a-long-random-string
RENDER_GIT_COMMIT=local
